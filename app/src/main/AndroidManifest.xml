<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CS2340C_Team28"
        tools:targetApi="34">
        <activity
            android:name=".activities.Screen1"
            android:exported="false"
            android:label="@string/title_activity_screen1"
            android:theme="@style/Theme.CS2340C_Team28" />
        <activity
            android:name=".activities.ConfigScreenActivity"
            android:exported="false" />
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main_welcome"
            android:theme="@style/Theme.CS2340C_Team28">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.GameActivity"
            android:exported="false" />
        <activity
            android:name=".activities.EndScreenActivity"
            android:exported="false"
            android:label="@string/title_activity_end_screen"
            android:theme="@style/Theme.CS2340C_Team28" />
    </application>

</manifest>