<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.LeaderboardV">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        tools:layout_editor_absoluteX="127dp"
        tools:layout_editor_absoluteY="184dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leaderboard"
            android:textSize="40dp" />

        <TextView
            android:id="@+id/entry1"
            android:layout_width="35dp"
            android:layout_height="wrap_content"
            android:text="1) " />

        <TextView
            android:id="@+id/entry1Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playerName" />

        <TextView
            android:id="@+id/entry1Score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score: " />

        <EditText
            android:id="@+id/entry2Time"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:ems="10"
            android:inputType="time" />

        <TextView
            android:id="@+id/entry2"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:text="2)" />

        <TextView
            android:id="@+id/entry2Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playerName" />

        <TextView
            android:id="@+id/entry2Score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score: " />

        <EditText
            android:id="@+id/entry3Time"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:ems="10"
            android:inputType="time" />

        <TextView
            android:id="@+id/entry3"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="3)" />

        <TextView
            android:id="@+id/entry3Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playerName" />

        <TextView
            android:id="@+id/entry3Score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score: " />

        <EditText
            android:id="@+id/entry1Time3"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:ems="10"
            android:inputType="time" />

        <TextView
            android:id="@+id/entry4"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="4)" />

        <TextView
            android:id="@+id/entry4Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playerName" />

        <TextView
            android:id="@+id/entry4Info2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score: " />

        <EditText
            android:id="@+id/entry4Time"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:ems="10"
            android:inputType="time" />

        <TextView
            android:id="@+id/entry5"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="5)" />

        <TextView
            android:id="@+id/entry5Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playerName" />

        <TextView
            android:id="@+id/entry5Info2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score: " />

        <EditText
            android:id="@+id/entry5Time"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:ems="10"
            android:inputType="time" />

        <TextView
            android:id="@+id/lastAttempt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAST ATTEMPT:" />

        <TextView
            android:id="@+id/lastAttemptInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playerName" />

        <TextView
            android:id="@+id/lastAttemptInfo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score: " />

        <EditText
            android:id="@+id/lastAttemptTime"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:ems="10"
            android:inputType="time" />

        <Button
            android:id="@+id/restartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Start" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>